# Secret Key for Flask Session Cookies & Security
SECRET_KEY=climatex-super-secret-key-2026-prod-ready

# MySQL Database Configuration
# Option 1: Individual Parameters
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=climatex

# Option 2: Full Database URL (Uncomment to use)
# DATABASE_URL=mysql+pymysql://root:your_mysql_password_here@127.0.0.1:3306/climatex
